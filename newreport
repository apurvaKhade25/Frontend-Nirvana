<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Nirvana — Wellness Report</title>
  <link rel="stylesheet" href="css/style.css"/>
</head>
<body>

<div id="toast-container"></div>

<div class="page-wrapper">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <span class="logo-text">Nirvana</span>
      <span class="logo-sub">Wellness</span>
    </div>
    <div class="sidebar-user">
      <div class="sidebar-avatar" id="sidebar-avatar">?</div>
      <div>
        <div class="sidebar-user-name" id="sidebar-name">Loading...</div>
        <div class="sidebar-user-tag">✦ Wellness member</div>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-label">Main</div>
      <a href="dashboard.html" class="nav-item"><span class="nav-icon">🏠</span> Dashboard</a>
      <a href="mood.html"      class="nav-item"><span class="nav-icon">😊</span> Mood Tracker</a>
      <a href="journal.html"   class="nav-item"><span class="nav-icon">📓</span> Journal</a>
      <div class="nav-section-label">AI Features</div>
      <a href="chat.html"      class="nav-item"><span class="nav-icon">🤖</span> AI Companion</a>
      <a href="report.html"    class="nav-item active"><span class="nav-icon">📊</span> Wellness Report</a>
      <div class="nav-section-label">Help</div>
      <a href="clinics.html"   class="nav-item"><span class="nav-icon">🏥</span> Find Clinics</a>
    </nav>
    <div class="sidebar-footer">
      <a href="#" class="nav-item" onclick="logout()"><span class="nav-icon">🚪</span> Log out</a>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="main-content">

    <div class="topbar">
      <div class="topbar-title">
        <h2>Wellness Report 📊</h2>
        <p>Your personalised weekly mental health summary, generated by AI.</p>
      </div>
      <div class="topbar-actions">
        <button class="btn btn-primary" onclick="generateReport()" id="gen-btn">
          <span id="gen-btn-text">✨ Generate report</span>
          <span id="gen-spinner" class="spinner hidden"
            style="border-color:rgba(255,255,255,0.3);border-top-color:white;width:16px;height:16px;"></span>
        </button>
      </div>
    </div>

    <!-- Hero banner -->
    <div class="page-hero mb-24">
      <h2>Weekly Wellness Summary</h2>
      <p id="report-week">Week of <span id="week-range">loading...</span></p>
    </div>

    <!-- Stat row -->
    <div class="grid-4 mb-24">
      <div class="stat-card">
        <div class="stat-value" id="rep-avg-mood">—</div>
        <div class="stat-label">Average mood</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="rep-journals">—</div>
        <div class="stat-label">Journal entries</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="rep-top-emotion">—</div>
        <div class="stat-label">Top emotion</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="rep-streak">—</div>
        <div class="stat-label">Logging streak</div>
      </div>
    </div>

    <div class="grid-2 mb-24" style="align-items:start;">

      <!-- AI Summary -->
      <div class="card card-lg">
        <div class="card-header">
          <div>
            <div class="card-title">AI-generated summary</div>
            <div class="card-subtitle">Personalised insight from your data</div>
          </div>
          <span class="icon-box icon-box-teal icon-box-lg">🧠</span>
        </div>

        <div id="ai-summary-area">
          <div style="background:var(--cream-mid);border-radius:var(--radius-md);
            padding:32px;text-align:center;color:var(--text-soft);">
            <div style="font-size:40px;margin-bottom:14px;">📊</div>
            <p style="font-size:14px;margin-bottom:16px;">
              Click <strong>"Generate report"</strong> to get your personalised
              weekly wellness summary powered by AI.
            </p>
            <button class="btn btn-primary btn-sm" onclick="generateReport()">
              Generate now
            </button>
          </div>
        </div>
      </div>

      <!-- Mood chart -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">Mood this week</div>
          <a href="mood.html" class="btn btn-ghost btn-sm">Log mood</a>
        </div>
        <div id="report-mood-chart"
          style="display:flex;align-items:flex-end;gap:8px;height:120px;margin-bottom:8px;">
          <div class="loading-overlay" style="padding:20px;width:100%;">
            <div class="spinner"></div>
          </div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:4px;"
          id="chart-labels"></div>
      </div>

    </div>

    <!-- Emotion + Recommendations -->
    <div class="grid-2 mb-24" style="align-items:start;">

      <div class="card">
        <div class="card-header">
          <div class="card-title">Emotion breakdown</div>
          <div class="card-subtitle">From your journal entries</div>
        </div>
        <div id="emotion-breakdown">
          <div class="loading-overlay" style="padding:20px;">
            <div class="spinner"></div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <div class="card-title">Recommendations</div>
          <div class="card-subtitle">Based on your week</div>
        </div>
        <div id="recommendations-area">
          <div class="empty-state" style="padding:24px;">
            <div class="empty-icon" style="font-size:32px;">💡</div>
            <h4>Generate your report first</h4>
            <p>Personalised recommendations will appear here.</p>
          </div>
        </div>
      </div>

    </div>

  </main>
</div>

<script>
const API_BASE = 'http://localhost:8080';
const token    = localStorage.getItem('nirvana_token');
const userStr  = localStorage.getItem('nirvana_user');

if (!token || token === '' || token === 'null' || token === 'undefined') {
  window.location.replace('index.html');
  throw new Error('no token');
}

// Safe user parse — never crashes
let user = { name: 'User', email: '' };
try {
  if (userStr && userStr !== 'null') {
    const p = JSON.parse(userStr);
    user = {
      name:  p.name || p.username || p.fullName || (p.email ? p.email.split('@')[0] : 'User'),
      email: p.email || ''
    };
  }
} catch(e) {}

// Set sidebar
const sName   = user.name || 'User';
const initials = sName.split(' ').filter(Boolean).map(n=>n[0]).join('').toUpperCase().slice(0,2) || 'U';
document.getElementById('sidebar-name').textContent   = sName;
document.getElementById('sidebar-avatar').textContent = initials;

// Week range
const now = new Date();
const mon = new Date(now); mon.setDate(now.getDate() - now.getDay() + 1);
const sun = new Date(mon); sun.setDate(mon.getDate() + 6);
document.getElementById('week-range').textContent =
  `${mon.toLocaleDateString('en-IN', { day:'numeric', month:'short' })} – ${sun.toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' })}`;

function showToast(msg, type='success') {
  const c = document.getElementById('toast-container');
  const t = document.createElement('div');
  t.className = `toast ${type==='error'?'error':''}`;
  t.innerHTML = `<span>${type==='error'?'❌':'✅'}</span><span>${msg}</span>`;
  c.appendChild(t);
  setTimeout(() => { t.style.animation='toastOut 0.3s ease forwards'; setTimeout(()=>t.remove(),300); }, 3500);
}

function logout() {
  localStorage.removeItem('nirvana_token');
  localStorage.removeItem('nirvana_user');
  window.location.href = 'index.html';
}

function renderMoodChart(moods) {
  const chart  = document.getElementById('report-mood-chart');
  const labels = document.getElementById('chart-labels');
  const days   = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];

  if (!moods || moods.length === 0) {
    chart.innerHTML = `<div class="empty-state" style="width:100%;padding:20px;"><p>No mood data yet.</p></div>`;
    return;
  }

  const data = moods.slice(-7);
  chart.innerHTML = data.map((m, i) => {
    const s = m.mood || m.score || 0;
    const h = Math.max(4, (s / 10) * 120);
    const c = s <= 3 ? 'var(--rose)' : s <= 6 ? 'var(--amber)' : 'var(--teal)';
    return `
      <div style="display:flex;flex-direction:column;align-items:center;flex:1;gap:4px;">
        <span style="font-size:11px;color:var(--text-soft);font-weight:500;">${s}</span>
        <div style="width:100%;height:${h}px;background:${c};border-radius:4px 4px 0 0;"></div>
      </div>`;
  }).join('');

  labels.innerHTML = data.map((m, i) => {
    const day = days[new Date(m.createdAt || m.created_at || Date.now()).getDay()] || days[i % 7];
    return `<span style="flex:1;font-size:10px;color:var(--text-soft);text-align:center;">${day}</span>`;
  }).join('');

  const avg = (data.reduce((s,m) => s + (m.mood || m.score || 0), 0) / data.length).toFixed(1);
  document.getElementById('rep-avg-mood').textContent = avg;
}

function renderEmotionBreakdown(emotions) {
  const area = document.getElementById('emotion-breakdown');
  if (!emotions || emotions.length === 0) {
    area.innerHTML = `<div class="empty-state" style="padding:24px;"><p>No emotion data yet. Write journal entries to see analysis.</p></div>`;
    return;
  }

  const colors = {
    joy:'var(--teal)', calm:'#534ab7', anxious:'var(--amber)',
    sad:'var(--rose)', fear:'var(--amber)', anger:'var(--rose)', surprise:'#4a90d9'
  };

  document.getElementById('rep-top-emotion').textContent = emotions[0]?.name || '—';

  area.innerHTML = emotions.map(e => {
    const pct   = Math.round((e.score || 0) * 100);
    const color = colors[e.name?.toLowerCase()] || 'var(--teal)';
    return `
      <div style="margin-bottom:14px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:5px;">
          <span style="font-size:13px;color:var(--text-mid);">${e.name}</span>
          <span style="font-size:12px;color:var(--text-soft);font-weight:500;">${pct}%</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" style="width:${pct}%;background:${color};"></div>
        </div>
      </div>`;
  }).join('');
}

function renderRecommendations(recs) {
  const area = document.getElementById('recommendations-area');
  if (!recs || recs.length === 0) {
    area.innerHTML = `<div class="empty-state" style="padding:24px;"><p>Generate your report to see recommendations.</p></div>`;
    return;
  }

  const icons = ['🌿','🧘','🚶','💧','📵','🌙','🤝'];
  area.innerHTML = recs.map((rec, i) => `
    <div style="display:flex;gap:12px;align-items:flex-start;
      padding:12px 0;border-bottom:1px solid var(--cream-dark);">
      <div style="width:32px;height:32px;border-radius:8px;background:var(--teal-pale);
        display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">
        ${icons[i % icons.length]}
      </div>
      <p style="font-size:13px;color:var(--text-mid);line-height:1.6;margin:5px 0 0;">${rec}</p>
    </div>`).join('');
}

async function loadReportData() {
  const headers = { 'Authorization': `Bearer ${token}` };

  // Load moods
  try {
    const res  = await fetch(`${API_BASE}/api/mood/history`, { headers });
    const data = await res.json();
    const moods = Array.isArray(data) ? data : (data.moods || data.history || []);
    renderMoodChart(moods);
    document.getElementById('rep-journals').textContent = moods.length;
    document.getElementById('rep-streak').textContent   = moods.length > 0 ? `${moods.length}🔥` : '0';
  } catch (e) {
    renderMoodChart([
      { mood:4 }, { mood:6 }, { mood:7 },
      { mood:5 }, { mood:8 }, { mood:6 }, { mood:7 }
    ]);
    document.getElementById('rep-journals').textContent = '7';
    document.getElementById('rep-streak').textContent   = '5🔥';
  }

  // Load emotions (demo for now)
  renderEmotionBreakdown([
    { name:'Joy',     score:0.45 },
    { name:'Calm',    score:0.28 },
    { name:'Anxious', score:0.18 },
    { name:'Sad',     score:0.09 }
  ]);
}

async function generateReport() {
  document.getElementById('gen-btn-text').textContent = 'Generating...';
  document.getElementById('gen-spinner').classList.remove('hidden');
  document.getElementById('gen-btn').disabled = true;

  const summaryArea = document.getElementById('ai-summary-area');
  summaryArea.innerHTML = `
    <div class="loading-overlay" style="padding:32px;">
      <div class="spinner spinner-lg"></div>
      <span>AI is analysing your week...</span>
    </div>`;

  try {
    // Try backend wellness report endpoint
    const res = await fetch(`${API_BASE}/api/report/weekly`, {
      headers: { 'Authorization': `Bearer ${token}` }
    });

    const data = await res.json();
    const summary = data.summary || data.report || data.message || '';
    const recs    = data.recommendations || [];

    summaryArea.innerHTML = `
      <div style="background:var(--teal-pale);border-radius:var(--radius-md);
        padding:20px;border-left:3px solid var(--teal);">
        <p style="font-size:14px;color:var(--teal-dark);line-height:1.8;font-style:italic;">
          "${summary}"
        </p>
      </div>`;

    renderRecommendations(recs);
    showToast('Weekly report generated! 📊');

  } catch (e) {
    // Demo report — shown when backend report endpoint not ready
    const firstName = sName.split(' ')[0];
    const demoSummary = `${firstName}, you had a thoughtful week. Your mood showed a positive trend. Your journal entries reflected a mix of emotions — try to build on the positive moments and acknowledge the difficult ones with self-compassion.`;

    const demoRecs = [
      'Try a 10-minute morning meditation to set a calm tone for your day.',
      'You seem to journal most when stressed — keep that habit, it genuinely helps.',
      'Your mood tends to peak on weekends — find one thing each weekday that brings that same joy.',
      'Try a short evening walk to wind down before bed.',
      'Drink at least 8 glasses of water daily — hydration directly affects mood and energy.'
    ];

    summaryArea.innerHTML = `
      <div style="background:var(--teal-pale);border-radius:var(--radius-md);
        padding:20px;border-left:3px solid var(--teal);">
        <p style="font-size:14px;color:var(--teal-dark);line-height:1.8;font-style:italic;">
          "${demoSummary}"
        </p>
        <div style="margin-top:10px;font-size:11px;color:var(--sage);">
          Demo mode — connect backend /api/report/weekly for real AI report
        </div>
      </div>`;

    renderRecommendations(demoRecs);
    showToast('Report generated! 📊');
  } finally {
    document.getElementById('gen-btn-text').textContent = '✨ Generate report';
    document.getElementById('gen-spinner').classList.add('hidden');
    document.getElementById('gen-btn').disabled = false;
  }
}

loadReportData();
</script>

</body>
</html>
